{
  "title": "QuoteCheck Input",
  "description": "Compare supplier quotes from PDFs or structured JSON and return machine-readable price, quantity, and exception data.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "quote_stores": {
      "title": "Supplier quote file stores",
      "type": "array",
      "description": "Select one or more Apify Key-Value Stores containing text-based supplier quote PDFs. QuoteCheck reads PDF records from the selected stores. Scanned PDFs requiring OCR are not supported in this MVP.",
      "editor": "resourcePicker",
      "resourceType": "keyValueStore",
      "resourcePermissions": [
        "READ"
      ],
      "minItems": 1,
      "maxItems": 10
    },
    "quotes": {
      "title": "Structured supplier quotes",
      "type": "array",
      "description": "Optional JSON input for API and agent workflows. Use this instead of quote storage.",
